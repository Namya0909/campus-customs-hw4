# Copy this file to TWO places and fill in real values — see README.md "Environment setup":
#   1. ./.env            (read by the backend — it searches its own folder and every parent)
#   2. ./frontend/.env    (read by Vite — it only ever reads from the frontend/ folder itself)
#
# Never commit the resulting .env files — they're already gitignored.

# --- Backend (backend/.env or repo-root .env) ---

# Required. Your Portkey API key (used to reach the LLM via the Portkey gateway).
PORTKEY_API_KEY=your-portkey-key-here

# Optional overrides (defaults shown):
# MODEL_NAME=gpt-5.6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional. Signs session cookies. A dev default is used if unset — set a real random
# value (e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`) before deploying
# anywhere other people can reach.
SESSION_SECRET=replace-with-a-long-random-value

# --- Frontend (frontend/.env) ---

# Required. Where the backend is running. Must match whatever port you start uvicorn on.
VITE_API_URL=http://localhost:8000
